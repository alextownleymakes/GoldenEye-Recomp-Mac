+
+bool XmaDecoder::GeStateRestore(const uint8_t* data, size_t size) {
+  size_t off = 0;
+  auto get = [&](void* p, size_t n) {
+    if (off + n > size) return false;
+    std::memcpy(p, data + off, n);
+    off += n;
+    return true;
+  };
+  uint32_t magic = 0, count = 0, words = 0;
+  if (!get(&magic, 4) || !get(&count, 4) || magic != kGeXmaStateMagic || count != kContextCount) {
+    return false;
+  }
+  if (!get(register_file_.values, sizeof(register_file_.values)) || !get(&words, 4)) {
+    return false;
+  }
+  auto& bits = context_bitmap_.data();
+  if (words != bits.size() || !get(bits.data(), words * sizeof(uint64_t))) {
+    return false;
+  }
+  if (!get(&context_data_first_ptr_, 4) || !get(&context_data_last_ptr_, 4)) {
+    return false;
+  }
+  for (uint32_t i = 0; i < kContextCount; ++i) {
+    uint8_t flags = 0;
+    if (!get(&flags, 1)) return false;
+    contexts_[i].GeRestore((flags & 1) != 0, (flags & 2) != 0);
+  }
+  return true;
+}
