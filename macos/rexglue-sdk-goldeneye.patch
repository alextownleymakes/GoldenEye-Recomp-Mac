+    const auto* b = static_cast<const uint8_t*>(p);
+    out.insert(out.end(), b, b + n);
+  };
+  const uint32_t magic = kGeXmaStateMagic, count = kContextCount;
+  put(&magic, 4);
+  put(&count, 4);
+  put(register_file_.values, sizeof(register_file_.values));
+  const auto& bits = context_bitmap_.data();
+  const uint32_t words = uint32_t(bits.size());
+  put(&words, 4);
+  put(bits.data(), bits.size() * sizeof(uint64_t));
+  put(&context_data_first_ptr_, 4);
+  put(&context_data_last_ptr_, 4);
+  for (uint32_t i = 0; i < kContextCount; ++i) {
+    const uint8_t flags =
+        uint8_t((contexts_[i].is_allocated() ? 1 : 0) | (contexts_[i].is_enabled() ? 2 : 0));
+    put(&flags, 1);
+  }
