+bool Memory::GeSaveState(GeStateSink& sink) {
+  BaseHeap* content_heaps[] = {&heaps_.v00000000, &heaps_.v40000000, &heaps_.v80000000,
+                               &heaps_.v90000000, &heaps_.physical};
+  BaseHeap* table_heaps[] = {&heaps_.vA0000000, &heaps_.vC0000000, &heaps_.vE0000000};
