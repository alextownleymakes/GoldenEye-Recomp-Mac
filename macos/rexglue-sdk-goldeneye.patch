diff --git a/src/rexglue/commands/extract_command.cpp b/src/rexglue/commands/extract_command.cpp
new file mode 100644
index 0000000..3da5a08
--- /dev/null
+++ b/src/rexglue/commands/extract_command.cpp
@@ -0,0 +1,165 @@
+/**
+ * @file        rexglue/commands/extract_command.cpp
+ * @brief       Extract an Xbox 360 STFS package (LIVE/PIRS/CON) to a folder
+ *
+ * XBLA titles ship as a single extensionless STFS package (the file under
+ * <title id>/000D0000/). Emulators mount it directly, but the recompiler needs
+ * the loose files (default.xex + data). This dumps every file with the SDK's
+ * own STFS reader (ported from Xenia, the same code the runtime mounts with).
+ *
+ *   rexglue extract <package> <output_dir>
+ */
+
+#include "extract_command.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <filesystem>
+#include <memory>
+#include <queue>
+#include <span>
+#include <string>
+#include <vector>
+
+#include <CLI/CLI.hpp>
+#include <fmt/format.h>
+
+#include <rex/filesystem.h>
+#include <rex/filesystem/devices/stfs_container_device.h>
+#include <rex/filesystem/entry.h>
+#include <rex/filesystem/file.h>
+#include <rex/logging.h>
+#include <rex/result.h>
+
+namespace rexglue::cli {
+
+using rex::Err;
+using rex::ErrorCategory;
+using rex::Result;
+using rex::X_STATUS;
+
+namespace fs = std::filesystem;
+
+namespace {
+
+struct ExtractArgs {
+  std::string package_path;
+  std::string output_dir;
+};
+
+Result<void> ExtractPackage(const fs::path& package, const fs::path& out_dir) {
+  std::error_code ec;
+  if (!fs::is_regular_file(package, ec)) {
+    return Err<void>(ErrorCategory::NotFound,
+                     fmt::format("Package not found: {}", package.string()));
+  }
+
+  auto device = std::make_unique<rex::filesystem::StfsContainerDevice>("", package);
+  if (!device->Initialize()) {
+    return Err<void>(ErrorCategory::Format,
+                     fmt::format("{} is not a readable STFS (LIVE/PIRS/CON) package",
+                                 package.string()));
+  }
+
+  fs::create_directories(out_dir, ec);
+
+  std::queue<rex::filesystem::Entry*> queue;
+  if (auto* root = device->ResolvePath("/")) {
+    queue.push(root);
+  }
+
+  std::vector<uint8_t> buffer(8u << 20);  // 8 MiB copy chunks
+  size_t files = 0;
+  uint64_t bytes = 0;
+  while (!queue.empty()) {
+    auto* entry = queue.front();
+    queue.pop();
+    for (auto& child : entry->children()) {
+      queue.push(child.get());
+    }
+    if (entry->path().empty() || entry->path() == "/") {
+      continue;
+    }
+
+    std::string rel = entry->path();
+    std::replace(rel.begin(), rel.end(), '\\', '/');  // STFS paths use '\\' separators
+    while (!rel.empty() && rel.front() == '/') rel.erase(rel.begin());
+    const fs::path dest = out_dir / rex::to_path(rel);
+
+    if (entry->attributes() & rex::filesystem::kFileAttributeDirectory) {
+      fs::create_directories(dest, ec);
+      continue;
+    }
+    fs::create_directories(dest.parent_path(), ec);
+
+    rex::filesystem::File* in_file = nullptr;
+    if (entry->Open(rex::filesystem::FileAccess::kFileReadData, &in_file) != X_STATUS_SUCCESS ||
+        !in_file) {
+      return Err<void>(ErrorCategory::IO, fmt::format("Failed to open {} in package", rel));
+    }
+    FILE* out = rex::filesystem::OpenFile(dest, "wb");
+    if (!out) {
+      in_file->Destroy();
+      return Err<void>(ErrorCategory::IO, fmt::format("Failed to create {}", dest.string()));
+    }
+
+    const size_t size = entry->size();
+    size_t offset = 0;
+    bool ok = true;
+    while (offset < size) {
+      size_t want = std::min(buffer.size(), size - offset);
+      size_t got = 0;
+      if (in_file->ReadSync(std::span<uint8_t>(buffer.data(), want), offset, &got) !=
+              X_STATUS_SUCCESS ||
+          got == 0) {
+        ok = false;
+        break;
+      }
+      if (fwrite(buffer.data(), 1, got, out) != got) {
+        ok = false;
+        break;
+      }
+      offset += got;
+    }
+    fclose(out);
+    in_file->Destroy();
+    if (!ok) {
+      return Err<void>(ErrorCategory::IO, fmt::format("Failed to extract {}", rel));
+    }
+    REXLOG_INFO("  {} ({} bytes)", rel, size);
+    ++files;
+    bytes += size;
+  }
+
+  if (files == 0) {
+    return Err<void>(ErrorCategory::Format, "Package contained no files");
+  }
+  REXLOG_INFO("Extracted {} files ({:.1f} MB) to {}", files, double(bytes) / (1024.0 * 1024.0),
+              out_dir.string());
+  return rex::Ok();
+}
+
+}  // namespace
+
+void RegisterExtract(CLI::App& parent, const CliContext& ctx, DeferredAction& pending) {
+  (void)ctx;
+  auto args = std::make_shared<ExtractArgs>();
+  auto* sub = parent
+                  .add_subcommand("extract",
+                                  "Extract an Xbox 360 STFS package (XBLA LIVE/PIRS/CON file) "
+                                  "to a folder")
+                  ->fallthrough();
+  sub->add_option("package", args->package_path, "Path to the STFS package file")
+      ->type_name("PATH")
+      ->required();
+  sub->add_option("output", args->output_dir, "Folder to extract into")
+      ->type_name("DIR")
+      ->required();
+  sub->callback([args, &pending]() {
+    pending = [args]() -> Result<void> {
+      return ExtractPackage(rex::to_path(args->package_path), rex::to_path(args->output_dir));
+    };
+  });
+}
+
+}  // namespace rexglue::cli
