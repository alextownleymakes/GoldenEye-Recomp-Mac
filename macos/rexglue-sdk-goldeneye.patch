+// ge colour-grade (port of shaders/ge_grade.cs.hlsl). Push constants extend the
+// FXAA block so one pipeline layout serves grade-only and FXAA+grade passes.
+constexpr std::string_view kGeGradePushConstants = R"(
+  float xe_brightness;
+  float xe_contrast;
+  float xe_saturation;
+  float xe_vibrance;
+  float xe_temperature;
+  float xe_gamma;
+  float xe_tint_r;
+  float xe_tint_g;
+  float xe_tint_b;
+  float xe_tint_strength;
+)";
+
+constexpr std::string_view kGeGradeFunction = R"(
+vec3 XeGeGrade(vec3 c) {
+  c.r += xe_temperature * 0.10;
+  c.b -= xe_temperature * 0.10;
+  c += xe_brightness;
+  c = (c - 0.5) * xe_contrast + 0.5;
+  c = mix(c, c * vec3(xe_tint_r, xe_tint_g, xe_tint_b), xe_tint_strength);
+  float luma = dot(max(c, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722));
+  c = mix(vec3(luma), c, xe_saturation);
+  float sat = max(c.r, max(c.g, c.b)) - min(c.r, min(c.g, c.b));
+  c = mix(vec3(luma), c, 1.0 + xe_vibrance * (1.0 - clamp(sat, 0.0, 1.0)));
+  c = pow(max(c, vec3(0.0001)), vec3(1.0 / xe_gamma));
+  return clamp(c, 0.0, 1.0);
+}
+)";
+
+// FXAA source with the grade applied to its output.
+std::string GetSwapFxaaGradeComputeSource(bool extreme_quality) {
+  std::string src = GetSwapFxaaComputeSource(extreme_quality);
+  const std::string_view size_inv = "vec2 xe_fxaa_size_inv;";
+  size_t pos = src.find(size_inv);
+  if (pos == std::string::npos) return {};
+  src.insert(pos + size_inv.size(), kGeGradePushConstants);
+  pos = src.find("void main() {");
+  if (pos == std::string::npos) return {};
+  src.insert(pos, kGeGradeFunction);
+  const std::string_view store = "vec4(result, 1.0)";
+  pos = src.rfind(store);
+  if (pos == std::string::npos) return {};
+  src.replace(pos, store.size(), "vec4(XeGeGrade(result), 1.0)");
+  return src;
+}
+
+// Grade-only pass: intermediate image -> guest output.
+std::string GetSwapGradeComputeSource() {
+  std::string src = R"(#version 450
+layout(local_size_x = 16, local_size_y = 8, local_size_z = 1) in;
+layout(push_constant) uniform XeGeGradeConstants {
+  uvec2 xe_fxaa_size;
+  vec2 xe_fxaa_size_inv;)";
+  src += kGeGradePushConstants;
+  src += R"(};
+layout(set = 0, binding = 0) uniform sampler2D xe_fxaa_source;
+layout(set = 1, binding = 0, rgb10_a2) writeonly uniform image2D xe_fxaa_dest;
+)";
+  src += kGeGradeFunction;
+  src += R"(
+void main() {
+  uvec2 pixel = gl_GlobalInvocationID.xy;
+  if (any(greaterThanEqual(pixel, xe_fxaa_size))) {
+    return;
+  }
+  vec3 c = texelFetch(xe_fxaa_source, ivec2(pixel), 0).rgb;
+  imageStore(xe_fxaa_dest, ivec2(pixel), vec4(XeGeGrade(c), 1.0));
+}
+)";
+  return src;
+}
