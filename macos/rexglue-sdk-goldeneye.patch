+// ============================================================================
+// Save
+// ============================================================================
+Result Save(const std::filesystem::path& file, uint32_t site_id, bool first_attempt,
+            std::string* message) {
+  auto* ks = kernel_state();
+  auto* self = XThread::GetCurrentThread();
+  if (!ks || !self || !self->is_guest_thread()) {
+    *message = "not on a game thread";
+    return Result::kFailed;
+  }
+  const auto t0 = Clock::now();
+
+  Freeze freeze(ks, first_attempt);
+  std::string why;
+  if (!freeze.Begin(&why)) {
+    if (LogThrottle()) REXSYS_INFO("GESTATE save waiting: {}", why);
+    *message = why;
+    return Result::kBusy;
+  }
+
+  REXSYS_INFO("GESTATE save: frozen, writing");
+  // Small sections first (threads, objects, GPU, XMA, clock), then memory.
+  std::vector<uint8_t> gpu_blob;
+  if (freeze.gpu() && !freeze.gpu()->GeStateSave(gpu_blob)) {
+    *message = "GPU busy";
+    return Result::kBusy;
+  }
+  std::vector<uint8_t> xma_blob;
+  if (freeze.audio() && freeze.audio()->xma_decoder()) {
+    freeze.audio()->xma_decoder()->GeStateSave(xma_blob);
+  }
+
+  std::error_code ec;
+  std::filesystem::create_directories(file.parent_path(), ec);
+  auto tmp = file;
+  tmp += ".tmp";
+  std::ofstream out(tmp, std::ios::binary | std::ios::trunc);
+  if (!out) {
+    *message = "can't write " + file.string();
+    return Result::kFailed;
+  }
+  out.write(kMagic, sizeof(kMagic));
+  FileSink sink(out);
+  Put(sink, kVersion);
+  Put(sink, site_id);
+
+  uint8_t* base = ks->memory()->virtual_membase();
+  auto threads = RunningGuestThreads(ks);
+  Put(sink, uint32_t(threads.size()));
+  for (auto& t : threads) {
+    ThreadRecord rec;
+    rec.handle = t->handle();
+    rec.thread_id = t->thread_id();
+    rec.start_address = t->creation_params()->start_address;
+    rec.is_current = t.get() == self ? 1 : 0;
+    rec.ctx = *t->thread_state()->context();
+    Put(sink, rec);
+  }
+  uint32_t chain[kChainDepth];
+  CallChain(base, uint32_t(self->thread_state()->context()->r1.u32), chain);
+  sink.Write(chain, sizeof(chain));
+
+  // Kernel objects with host-side state.
+  std::vector<uint8_t> objs;
+  uint32_t obj_count = 0;
+  for (auto& obj : ks->object_table()->GetAllObjects()) {
+    if (!obj) continue;
+    uint8_t type = 0;
+    int64_t value = 0;
+    uint8_t flag = 0;
+    switch (obj->type()) {
+      case XObject::Type::Event: {
+        bool render_pending = false;
+        type = kObjEvent;
+        value = static_cast<XEvent*>(obj.get())->GeGetState(&render_pending) ? 1 : 0;
+        flag = render_pending ? 1 : 0;
+        break;
+      }
+      case XObject::Type::Semaphore:
+        type = kObjSemaphore;
+        value = static_cast<XSemaphore*>(obj.get())->GeGetCount();
+        break;
+      case XObject::Type::File:
+        type = kObjFile;
+        value = int64_t(static_cast<XFile*>(obj.get())->position());
+        break;
+      default:
+        continue;
+    }
+    const uint32_t handle = obj->handle();
+    objs.insert(objs.end(), reinterpret_cast<const uint8_t*>(&handle),
+                reinterpret_cast<const uint8_t*>(&handle) + 4);
+    objs.push_back(type);
+    objs.push_back(flag);
+    objs.insert(objs.end(), reinterpret_cast<const uint8_t*>(&value),
+                reinterpret_cast<const uint8_t*>(&value) + 8);
+    ++obj_count;
+  }
+  Put(sink, obj_count);
+  sink.Write(objs.data(), objs.size());
+
+  Put(sink, uint32_t(gpu_blob.size()));
+  sink.Write(gpu_blob.data(), gpu_blob.size());
+  Put(sink, uint32_t(xma_blob.size()));
+  sink.Write(xma_blob.data(), xma_blob.size());
+  Put(sink, uint64_t(chrono::Clock::QueryGuestTickCount()));
+
+  REXSYS_INFO("GESTATE save: {} threads, {} objects recorded; writing memory", threads.size(),
+              obj_count);
+  bool ok;
+  {
+    auto lock = rex::thread::global_critical_region::AcquireDirect();
+    ok = ks->memory()->GeSaveState(sink);
+  }
+  ok = ok && sink.Finish();
+  out.close();
+  freeze.End();
+
+  if (!ok) {
+    std::filesystem::remove(tmp, ec);
+    *message = "write failed";
+    return Result::kFailed;
+  }
+  std::filesystem::rename(tmp, file, ec);
+  if (ec) {
+    *message = "write failed: " + ec.message();
+    return Result::kFailed;
+  }
+  const auto ms =
+      std::chrono::duration_cast<std::chrono::milliseconds>(Clock::now() - t0).count();
+  const auto size_mb = std::filesystem::file_size(file, ec) / (1024.0 * 1024.0);
+  REXSYS_INFO("GESTATE saved {} ({} threads, {} objects, {:.1f} MB raw -> {:.1f} MB, {} ms)",
+              file.string(), threads.size(), obj_count, sink.raw_bytes() / (1024.0 * 1024.0),
+              size_mb, ms);
+  *message = "saved";
+  return Result::kOk;
+}
+
+// ============================================================================
+// Load
+// ============================================================================
+Result Load(const std::filesystem::path& file, uint32_t site_id, bool first_attempt,
+            std::string* message) {
+  auto* ks = kernel_state();
+  auto* self = XThread::GetCurrentThread();
+  if (!ks || !self || !self->is_guest_thread()) {
+    *message = "not on a game thread";
+    return Result::kFailed;
+  }
+  std::ifstream in(file, std::ios::binary);
+  if (!in) {
+    *message = "no quicksave yet";
+    return Result::kNoState;
+  }
+  char magic[sizeof(kMagic)];
+  in.read(magic, sizeof(magic));
+  if (!in || std::memcmp(magic, kMagic, sizeof(kMagic)) != 0) {
+    *message = "not a save file";
+    return Result::kFailed;
+  }
+  const auto t0 = Clock::now();
+  FileSource src(in);
+  uint32_t version = 0, saved_site = 0, thread_count = 0;
+  if (!src.Get(version) || version != kVersion || !src.Get(saved_site) ||
+      !src.Get(thread_count) || thread_count > 1024) {
+    *message = "save file from a different version";
+    return Result::kFailed;
+  }
+  if (saved_site != site_id) {
+    *message = "different place in the game";
+    return Result::kMismatch;
+  }
+  std::vector<ThreadRecord> saved(thread_count);
+  for (auto& rec : saved) {
+    if (!src.Get(rec)) {
+      *message = "save file damaged";
+      return Result::kFailed;
+    }
+  }
+  uint32_t saved_chain[kChainDepth];
+  uint32_t obj_count = 0;
+  if (!src.Read(saved_chain, sizeof(saved_chain)) || !src.Get(obj_count) || obj_count > 1000000) {
+    *message = "save file damaged";
+    return Result::kFailed;
+  }
+  std::vector<uint8_t> objs(size_t(obj_count) * 14);
+  uint32_t gpu_size = 0, xma_size = 0;
+  std::vector<uint8_t> gpu_blob, xma_blob;
+  uint64_t saved_ticks = 0;
+  bool header_ok = src.Read(objs.data(), objs.size()) && src.Get(gpu_size) && gpu_size < (1u << 20);
+  if (header_ok) {
+    gpu_blob.resize(gpu_size);
+    header_ok = src.Read(gpu_blob.data(), gpu_size) && src.Get(xma_size) && xma_size < (1u << 24);
+  }
+  if (header_ok) {
+    xma_blob.resize(xma_size);
+    header_ok = src.Read(xma_blob.data(), xma_size) && src.Get(saved_ticks);
+  }
+  if (!header_ok) {
+    *message = "save file damaged";
+    return Result::kFailed;
+  }
+
+  // The calling thread must be the saved one, reached the same way.
+  uint8_t* base = ks->memory()->virtual_membase();
+  const ThreadRecord* saved_self = nullptr;
+  for (auto& rec : saved) {
+    if (rec.is_current) saved_self = &rec;
+  }
+  PPCContext* self_ctx = self->thread_state()->context();
+  uint32_t chain[kChainDepth];
+  CallChain(base, self_ctx->r1.u32, chain);
+  if (!saved_self || saved_self->handle != self->handle() ||
+      saved_self->ctx.r1.u32 != self_ctx->r1.u32 ||
+      std::memcmp(chain, saved_chain, sizeof(chain)) != 0) {
+    if (LogThrottle()) {
+      REXSYS_INFO("GESTATE load waiting: caller r1={:08X} chain[0..2]={:08X} {:08X} {:08X}, saved "
+                  "r1={:08X} chain[0..2]={:08X} {:08X} {:08X}",
+                  self_ctx->r1.u32, chain[0], chain[1], chain[2],
+                  saved_self ? saved_self->ctx.r1.u32 : 0, saved_chain[0], saved_chain[1],
+                  saved_chain[2]);
+    }
+    *message = "different place in the game";
+    return Result::kMismatch;
+  }
+
+  // Cheap pre-check before freezing anything: are the other threads already
+  // sitting where they were saved? (Re-checked properly once frozen.)
+  {
+    auto now_threads = RunningGuestThreads(ks);
+    bool plausible = now_threads.size() == saved.size();
+    for (size_t i = 0; plausible && i < now_threads.size(); ++i) {
+      const PPCContext* c = now_threads[i]->thread_state()->context();
+      plausible = saved[i].handle == now_threads[i]->handle() &&
+                  (saved[i].is_current ||
+                   (saved[i].ctx.r1.u32 == c->r1.u32 && saved[i].ctx.lr == c->lr));
+    }
+    if (!plausible) {
+      if (LogThrottle()) {
+        REXSYS_INFO("GESTATE load waiting: {} running threads now, {} saved",
+                    now_threads.size(), saved.size());
+        for (size_t i = 0; i < std::max(now_threads.size(), saved.size()); ++i) {
+          const uint32_t nh = i < now_threads.size() ? now_threads[i]->handle() : 0;
+          const PPCContext* c = i < now_threads.size() ? now_threads[i]->thread_state()->context()
+                                                       : nullptr;
+          REXSYS_INFO("GESTATE   #{} now {:08X} r1={:08X} lr={:08X} | saved {:08X} r1={:08X} "
+                      "lr={:08X}{}",
+                      i, nh, c ? c->r1.u32 : 0, c ? uint32_t(c->lr) : 0,
+                      i < saved.size() ? saved[i].handle : 0,
+                      i < saved.size() ? saved[i].ctx.r1.u32 : 0,
+                      i < saved.size() ? uint32_t(saved[i].ctx.lr) : 0,
+                      i < saved.size() && saved[i].is_current ? " (this thread)" : "");
+        }
+      }
+      *message = "game threads not in the saved position";
+      return Result::kMismatch;
+    }
+  }
+
+  Freeze freeze(ks, first_attempt);
+  std::string why;
+  if (!freeze.Begin(&why)) {
+    if (LogThrottle()) REXSYS_INFO("GESTATE load waiting: {}", why);
+    *message = why;
+    return Result::kBusy;
+  }
+
+  // Every other running guest thread must be parked exactly where it was.
+  auto threads = RunningGuestThreads(ks);
+  if (threads.size() != saved.size()) {
+    REXSYS_INFO("GESTATE load refused: {} running threads now, {} saved", threads.size(),
+                saved.size());
+    *message = "game state changed too much (threads)";
+    return Result::kMismatch;
+  }
+  for (size_t i = 0; i < threads.size(); ++i) {
+    const auto& t = threads[i];
+    const ThreadRecord& rec = saved[i];
+    const PPCContext* ctx = t->thread_state()->context();
+    const bool same = rec.handle == t->handle() &&
+                      rec.start_address == t->creation_params()->start_address &&
+                      (rec.is_current || (rec.ctx.r1.u32 == ctx->r1.u32 && rec.ctx.lr == ctx->lr));
+    if (!same) {
+      REXSYS_INFO(
+          "GESTATE load refused: thread {:08X} (start {:08X}) saved at r1={:08X} lr={:08X}, now "
+          "r1={:08X} lr={:08X}",
+          rec.handle, rec.start_address, rec.ctx.r1.u32, uint32_t(rec.ctx.lr), ctx->r1.u32,
+          uint32_t(ctx->lr));
+      *message = "game threads not in the saved position";
+      return Result::kMismatch;
+    }
+  }
+  // Every saved kernel object must still exist with the same type.
+  for (uint32_t i = 0; i < obj_count; ++i) {
+    uint32_t handle;
+    std::memcpy(&handle, &objs[i * 14], 4);
+    const uint8_t type = objs[i * 14 + 4];
+    auto obj = ks->object_table()->LookupObject<XObject>(handle);
+    const bool ok = obj && ((type == kObjEvent && obj->type() == XObject::Type::Event) ||
+                            (type == kObjSemaphore && obj->type() == XObject::Type::Semaphore) ||
+                            (type == kObjFile && obj->type() == XObject::Type::File));
+    if (!ok) {
+      REXSYS_INFO("GESTATE load refused: kernel object {:08X} (type {}) no longer exists", handle,
+                  type);
+      *message = "game state changed too much (objects)";
+      return Result::kMismatch;
+    }
+  }
+
+  // ---- Point of no return: rewrite the world. ----
+  REXSYS_INFO("GESTATE load: frozen and matched; restoring memory");
+  if (!ks->memory()->GeRestoreState(src)) {
+    REXSYS_ERROR("GESTATE: memory restore failed part-way; the game may crash");
+    *message = "load failed (memory)";
+    return Result::kFailed;
+  }
+  REXSYS_INFO("GESTATE load: memory restored; threads, objects, audio, GPU");
+  for (size_t i = 0; i < threads.size(); ++i) {
+    *threads[i]->thread_state()->context() = saved[i].ctx;
+  }
+  for (uint32_t i = 0; i < obj_count; ++i) {
+    uint32_t handle;
+    int64_t value;
+    std::memcpy(&handle, &objs[i * 14], 4);
+    const uint8_t type = objs[i * 14 + 4], flag = objs[i * 14 + 5];
+    std::memcpy(&value, &objs[i * 14 + 6], 8);
+    auto obj = ks->object_table()->LookupObject<XObject>(handle);
+    if (!obj) continue;
+    if (type == kObjEvent) {
+      static_cast<XEvent*>(obj.get())->GeSetState(value != 0, flag != 0);
+    } else if (type == kObjSemaphore) {
+      static_cast<XSemaphore*>(obj.get())->GeSetCount(int32_t(value));
+    } else if (type == kObjFile) {
+      static_cast<XFile*>(obj.get())->set_position(uint64_t(value));
+    }
+  }
+  if (freeze.audio() && freeze.audio()->xma_decoder() && !xma_blob.empty()) {
+    freeze.audio()->xma_decoder()->GeStateRestore(xma_blob.data(), xma_blob.size());
+  }
+  if (freeze.gpu() && !gpu_blob.empty() &&
+      !freeze.gpu()->GeStateRestore(gpu_blob.data(), gpu_blob.size())) {
+    REXSYS_ERROR("GESTATE: GPU state restore failed");
+  }
+  chrono::Clock::GeSetGuestTickCount(saved_ticks);
+  freeze.End();
+
+  const auto ms =
+      std::chrono::duration_cast<std::chrono::milliseconds>(Clock::now() - t0).count();
+  REXSYS_INFO("GESTATE loaded {} ({} threads, {} objects, {} ms)", file.string(), threads.size(),
+              obj_count, ms);
+  *message = "loaded";
+  return Result::kOk;
+}
+
