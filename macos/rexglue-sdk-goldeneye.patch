diff --git a/include/rex/system/ge_savestate.h b/include/rex/system/ge_savestate.h
new file mode 100644
index 0000000..8e63ea6
--- /dev/null
+++ b/include/rex/system/ge_savestate.h
@@ -0,0 +1,77 @@
+/**
+ * GoldenEye fork: quicksave / quickload ("freeze / thaw") for a recompiled title.
+ *
+ * An emulator can snapshot the whole virtual machine at any instant. A recompiled
+ * game cannot: part of its live state is the host call stack of each thread. So a
+ * snapshot is only taken (and only restored) at a *safe point*: the calling guest
+ * thread is at a fixed hook site, and every other guest-code-running thread is
+ * parked inside a kernel wait (so its host stack holds nothing but the wait).
+ *
+ * Guest execution accounting: every host->guest entry (FunctionDispatcher) and
+ * every blocking kernel wait report through ExecScope / BlockScope. While a
+ * snapshot is in progress, threads trying to (re)enter guest code are held at a
+ * gate until it finishes.
+ *
+ * What is captured: all guest memory (page tables + contents), every running guest
+ * thread's registers, kernel event / semaphore signal state, the GPU command
+ * processor's ring pointers and register file, XMA decoder state, guest time.
+ * On restore every thread must be parked at the same place it was when saved
+ * (same stack pointer / return address); otherwise the load is refused.
+ */
+#pragma once
+
+#include <cstdint>
+#include <filesystem>
+#include <string>
+#include <vector>
+
+namespace rex::system::ge_state {
+
+// --- Guest execution accounting (used by the runtime; not for game code) -----
+// A thread is "counted" while it runs guest code outside a kernel wait.
+struct ExecScope {
+  ExecScope();
+  ~ExecScope();
+  ExecScope(const ExecScope&) = delete;
+  ExecScope& operator=(const ExecScope&) = delete;
+
+ private:
+  bool prev_;
+};
+struct BlockScope {
+  BlockScope();
+  ~BlockScope();
+  BlockScope(const BlockScope&) = delete;
+  BlockScope& operator=(const BlockScope&) = delete;
+
+ private:
+  bool prev_;
+};
+
+// True while a save or load has the game frozen (host-side helpers that poke guest
+// memory, e.g. watchdogs, should stand down).
+bool InProgress();
+
+// --- Save / load ----------------------------------------------------------------
+enum class Result {
+  kOk,        // done
+  kBusy,      // not at a safe moment; try again next frame
+  kNoState,   // (load) no save file
+  kMismatch,  // (load) the game is not in a state this save can be restored into
+  kFailed,    // error (see message)
+};
+
+// Both must be called on a guest thread from inside a game hook (the safe point).
+// `site_id` identifies the hook so a state is only restored at the hook it was
+// saved at. `message` receives a short human-readable result.
+// `first_attempt`: the first try of a request may wait longer (~120 ms) for the
+// game to go quiet; retries on later frames wait ~30 ms so play stays smooth.
+Result Save(const std::filesystem::path& file, uint32_t site_id, bool first_attempt,
+            std::string* message);
+Result Load(const std::filesystem::path& file, uint32_t site_id, bool first_attempt,
+            std::string* message);
+
+// Small growable byte buffer used by subsystem snapshot helpers.
+using Blob = std::vector<uint8_t>;
+
+}  // namespace rex::system::ge_state
