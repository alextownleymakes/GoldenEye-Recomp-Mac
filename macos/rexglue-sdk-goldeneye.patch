+// ============================================================================
+// Guest execution accounting + gate
+// ============================================================================
+namespace {
+std::atomic<int> g_running{0};        // threads running guest code (outside waits)
+std::atomic<bool> g_active{false};    // a snapshot is in progress: hold everyone else
+std::mutex g_gate_mutex;
+std::condition_variable g_gate_cv;
+thread_local bool t_counted = false;
+
+// Diagnostics: which threads are currently counted (to name them when a freeze
+// can't get everyone parked).
+struct ThreadInfo {
+  std::atomic<bool> counted{false};
+  std::string name;
+};
+std::mutex g_registry_mutex;
+std::vector<ThreadInfo*> g_registry;
+thread_local ThreadInfo* t_info = nullptr;
+
+ThreadInfo* CurrentInfo() {
+  if (!t_info) {
+    t_info = new ThreadInfo();  // lives for the process (threads are long-lived)
+    if (XThread::IsInThread()) {
+      auto* xt = XThread::GetCurrentThread();
+      t_info->name = xt->name().empty() ? "guest thread" : xt->name();
+      char buf[32];
+      std::snprintf(buf, sizeof(buf), " (%08X)", xt->handle());
+      t_info->name += buf;
+    } else {
+      t_info->name = "host thread";
+    }
+    std::lock_guard<std::mutex> lock(g_registry_mutex);
+    g_registry.push_back(t_info);
+  }
+  return t_info;
+}
+
+std::string CountedThreadNames() {
+  std::string out;
+  std::lock_guard<std::mutex> lock(g_registry_mutex);
+  for (ThreadInfo* info : g_registry) {
+    if (info != t_info && info->counted.load()) {
+      if (!out.empty()) out += ", ";
+      out += info->name;
+    }
+  }
+  return out;
+}
+
+void SetCounted(bool counted) {
+  if (counted == t_counted) {
+    return;
+  }
+  CurrentInfo()->counted.store(counted);
+  if (counted) {
+    for (;;) {
+      g_running.fetch_add(1, std::memory_order_seq_cst);
+      if (!g_active.load(std::memory_order_seq_cst)) {
+        break;
+      }
+      // A snapshot is running: step back out and wait for it to finish.
+      g_running.fetch_sub(1, std::memory_order_seq_cst);
+      std::unique_lock<std::mutex> lock(g_gate_mutex);
+      g_gate_cv.wait(lock, [] { return !g_active.load(std::memory_order_seq_cst); });
+    }
+  } else {
+    g_running.fetch_sub(1, std::memory_order_seq_cst);
+  }
+  t_counted = counted;
+}
+}  // namespace
+
+bool InProgress() { return g_active.load(std::memory_order_relaxed); }
+
+ExecScope::ExecScope() : prev_(t_counted) { SetCounted(true); }
+ExecScope::~ExecScope() { SetCounted(prev_); }
+BlockScope::BlockScope() : prev_(t_counted) { SetCounted(false); }
+BlockScope::~BlockScope() { SetCounted(prev_); }
