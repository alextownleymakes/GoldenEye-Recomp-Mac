+namespace {
+constexpr uint8_t kGePageZero = 0;
+constexpr uint8_t kGePageData = 1;
+constexpr uint8_t kGePageSkip = 2;
+}  // namespace
+
+bool BaseHeap::GeSave(GeStateSink& sink, bool contents) {
+  const uint32_t count = uint32_t(page_table_.size());
+  sink.Write(&heap_base_, sizeof(heap_base_));
+  sink.Write(&count, sizeof(count));
+  sink.Write(page_table_.data(), sizeof(PageEntry) * page_table_.size());
+  if (!contents) {
+    return true;
+  }
+  static const std::vector<uint8_t> zeros(64 * 1024, 0);
+  // Host-protection cache: never touch a page the host would fault on, even if
+  // the guest page table says it is readable (a fault here would loop forever
+  // in the guest access-violation handler).
+  const uint8_t* region_start = nullptr;
+  const uint8_t* region_end = nullptr;
+  bool region_readable = false;
+  auto host_readable = [&](const uint8_t* p, size_t n) -> bool {
+    const uint8_t* end = p + n;
+    while (p < end) {
+      if (!(p >= region_start && p < region_end)) {
+        size_t length = 0;
+        rex::memory::PageAccess access = rex::memory::PageAccess::kNoAccess;
+        if (!rex::memory::QueryProtect(const_cast<uint8_t*>(p), length, access) || !length) {
+          return false;
+        }
+        region_start = p;
+        region_end = p + length;
+        region_readable = (static_cast<int>(access) &
+                           static_cast<int>(rex::memory::PageAccess::kReadOnly)) != 0;
+      }
+      if (!region_readable) return false;
+      p = region_end;
+    }
+    return true;
+  };
+  for (uint32_t i = 0; i < count; ++i) {
+    const PageEntry& page = page_table_[i];
+    if (!page.state || !(page.state & memory::kMemoryAllocationCommit)) {
+      continue;
+    }
+    const uint8_t* addr = TranslateRelative<const uint8_t*>(i << page_size_shift_);
+    if (!(page.current_protect & memory::kMemoryProtectRead) || !host_readable(addr, page_size_)) {
+      sink.Write(&kGePageSkip, 1);
+      continue;
+    }
+    bool zero = true;
+    for (uint32_t off = 0; off < page_size_ && zero; off += uint32_t(zeros.size())) {
+      const size_t n = std::min<size_t>(zeros.size(), page_size_ - off);
+      zero = std::memcmp(addr + off, zeros.data(), n) == 0;
+    }
+    if (zero) {
+      sink.Write(&kGePageZero, 1);
+    } else {
+      sink.Write(&kGePageData, 1);
+      sink.Write(addr, page_size_);
+    }
+  }
+  return true;
+}
+
+bool BaseHeap::GeRestore(GeStateSource& source, bool contents) {
+  uint32_t base = 0, count = 0;
+  if (!source.Read(&base, sizeof(base)) || !source.Read(&count, sizeof(count))) {
+    return false;
+  }
+  if (base != heap_base_ || count != page_table_.size()) {
+    REXSYS_ERROR("GESTATE heap {:08X} layout mismatch (saved {:08X}/{} pages)", heap_base_, base,
+                 count);
+    return false;
+  }
+  if (!source.Read(page_table_.data(), sizeof(PageEntry) * page_table_.size())) {
+    return false;
+  }
+
+  const uint32_t host_page_size = memory_->system_page_size_;
+  const bool reconcile_host_pages = page_size_ < host_page_size;
+  uint32_t writable_host_page = UINT32_MAX;
+  auto global_lock = AcquireHostPageReconcileLock();
+
+  for (uint32_t i = 0; i < count; ++i) {
+    const PageEntry& page = page_table_[i];
+    if (!page.state || !(page.state & memory::kMemoryAllocationCommit)) {
+      continue;
+    }
+    uint8_t flag = kGePageSkip;
+    if (contents && !source.Read(&flag, 1)) {
+      return false;
+    }
+    memory::PageAccess page_access = memory::PageAccess::kNoAccess;
+    if ((page.current_protect & memory::kMemoryProtectRead) &&
+        (page.current_protect & memory::kMemoryProtectWrite)) {
+      page_access = memory::PageAccess::kReadWrite;
+    } else if (page.current_protect & memory::kMemoryProtectRead) {
+      page_access = memory::PageAccess::kReadOnly;
+    }
+    uint8_t* addr = TranslateRelative<uint8_t*>(i << page_size_shift_);
+    if (!reconcile_host_pages) {
+      rex::memory::AllocFixed(addr, page_size_, memory::AllocationType::kCommit,
+                              memory::PageAccess::kReadWrite);
+      rex::memory::Protect(addr, page_size_, memory::PageAccess::kReadWrite, nullptr);
+    } else {
+      const uint32_t host_page =
+          uint32_t(((uint64_t(i) << page_size_shift_) + host_address_offset_) / host_page_size);
+      if (host_page != writable_host_page) {
+        uint8_t* host_page_pointer = membase_ + heap_base_ + size_t(host_page) * host_page_size;
+        if (!rex::memory::AllocFixed(host_page_pointer, host_page_size,
+                                     memory::AllocationType::kCommit,
+                                     memory::PageAccess::kReadWrite)) {
+          REXSYS_ERROR("GESTATE: failed to make host page {} writable", host_page);
+          return false;
+        }
+        writable_host_page = host_page;
+      }
+    }
+    if (flag == kGePageData) {
+      if (!source.Read(addr, page_size_)) {
+        return false;
+      }
+    } else if (flag == kGePageZero) {
+      std::memset(addr, 0, page_size_);
+    }
+    if (!reconcile_host_pages) {
+      rex::memory::Protect(addr, page_size_, page_access, nullptr);
+    }
+  }
+
+  if (reconcile_host_pages && !page_table_.empty()) {
+    if (!SyncHostPageAccess(0, uint32_t(page_table_.size()) - 1)) {
+      return false;
+    }
+  }
+  return true;
+}
+
 void BaseHeap::Reset() {
   // TODO(DrChat): protect pages.
   std::memset(page_table_.data(), 0, sizeof(PageEntry) * page_table_.size());
