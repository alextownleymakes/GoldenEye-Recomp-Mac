+// ============================================================================
+// Compressed file stream (chunked; LZ4 on macOS, stored elsewhere)
+// ============================================================================
+constexpr char kMagic[8] = {'G', 'E', 'S', 'T', 'A', 'T', 'E', '1'};
+constexpr uint32_t kVersion = 1;
+constexpr size_t kChunk = 4u << 20;
+
+class FileSink : public memory::GeStateSink {
+ public:
+  explicit FileSink(std::ofstream& out) : out_(out) { buf_.reserve(kChunk); }
+  void Write(const void* data, size_t size) override {
+    const auto* p = static_cast<const uint8_t*>(data);
+    while (size) {
+      const size_t n = std::min(size, kChunk - buf_.size());
+      buf_.insert(buf_.end(), p, p + n);
+      p += n;
+      size -= n;
+      if (buf_.size() == kChunk) Flush();
+    }
+  }
+  bool Finish() {
+    Flush();
+    const uint32_t end[2] = {0, 0};
+    out_.write(reinterpret_cast<const char*>(end), sizeof(end));
+    return bool(out_);
+  }
+  uint64_t raw_bytes() const { return raw_; }
+
+ private:
+  void Flush() {
+    if (buf_.empty()) return;
+    uint32_t raw_size = uint32_t(buf_.size()), comp_size = 0;
+#if defined(__APPLE__)
+    comp_.resize(buf_.size() + buf_.size() / 16 + 4096);
+    comp_size = uint32_t(compression_encode_buffer(comp_.data(), comp_.size(), buf_.data(),
+                                                   buf_.size(), nullptr, COMPRESSION_LZ4));
+#endif
+    out_.write(reinterpret_cast<const char*>(&raw_size), 4);
+    out_.write(reinterpret_cast<const char*>(&comp_size), 4);
+    if (comp_size) {
+      out_.write(reinterpret_cast<const char*>(comp_.data()), comp_size);
+    } else {
+      out_.write(reinterpret_cast<const char*>(buf_.data()), raw_size);
+    }
+    raw_ += raw_size;
+    buf_.clear();
+  }
+  std::ofstream& out_;
+  std::vector<uint8_t> buf_;
+  std::vector<uint8_t> comp_;
+  uint64_t raw_ = 0;
+};
+
+class FileSource : public memory::GeStateSource {
+ public:
+  explicit FileSource(std::ifstream& in) : in_(in) {}
+  bool Read(void* data, size_t size) override {
+    auto* p = static_cast<uint8_t*>(data);
+    while (size) {
+      if (pos_ == buf_.size() && !NextChunk()) return false;
+      const size_t n = std::min(size, buf_.size() - pos_);
+      std::memcpy(p, buf_.data() + pos_, n);
+      pos_ += n;
+      p += n;
+      size -= n;
+    }
+    return true;
+  }
+  template <typename T>
+  bool Get(T& v) {
+    return Read(&v, sizeof(T));
+  }
+
+ private:
+  bool NextChunk() {
+    uint32_t raw_size = 0, comp_size = 0;
+    in_.read(reinterpret_cast<char*>(&raw_size), 4);
+    in_.read(reinterpret_cast<char*>(&comp_size), 4);
+    if (!in_ || raw_size == 0 || raw_size > kChunk) return false;
+    buf_.resize(raw_size);
+    pos_ = 0;
+    if (!comp_size) {
+      in_.read(reinterpret_cast<char*>(buf_.data()), raw_size);
+      return bool(in_);
+    }
+#if defined(__APPLE__)
+    comp_.resize(comp_size);
+    in_.read(reinterpret_cast<char*>(comp_.data()), comp_size);
+    if (!in_) return false;
+    return compression_decode_buffer(buf_.data(), raw_size, comp_.data(), comp_size, nullptr,
+                                     COMPRESSION_LZ4) == raw_size;
+#else
+    return false;
+#endif
+  }
+  std::ifstream& in_;
+  std::vector<uint8_t> buf_;
+  std::vector<uint8_t> comp_;
+  size_t pos_ = 0;
+};
+
+template <typename T>
+void Put(memory::GeStateSink& s, const T& v) {
+  s.Write(&v, sizeof(T));
+}
+
+// ============================================================================
+// Thread signatures
+// ============================================================================
+struct ThreadRecord {
+  uint32_t handle = 0;
+  uint32_t thread_id = 0;
+  uint32_t start_address = 0;
+  uint8_t is_current = 0;
+  PPCContext ctx;
+};
+
+constexpr int kChainDepth = 16;
+
+// Guest call chain of the current thread: the saved return addresses walking the
+// PPC back-chain from r1. Together with r1 it identifies "the same place, called
+// the same way", which is what makes the host stack equivalent.
+// True if 4 bytes at guest address `addr` can be read without faulting (checks
+// the real host page protection: the top of a stack is followed by unmapped
+// memory, and the back-chain of the outermost frame can point right at it).
+bool GuestReadable(const uint8_t* base, uint32_t addr) {
+  size_t length = 0;
+  rex::memory::PageAccess access = rex::memory::PageAccess::kNoAccess;
+  if (!rex::memory::QueryProtect(const_cast<uint8_t*>(base + addr), length, access)) {
+    return false;
+  }
+  return (static_cast<int>(access) & static_cast<int>(rex::memory::PageAccess::kReadOnly)) != 0 &&
+         length >= 4;
+}
+
+void CallChain(const uint8_t* base, uint32_t r1, uint32_t out[kChainDepth]) {
+  std::memset(out, 0, sizeof(uint32_t) * kChainDepth);
+  uint32_t frame = r1;
+  for (int i = 0; i < kChainDepth; ++i) {
+    if (frame < 0x10000 || frame >= 0x80000000u || (frame & 3)) break;
+    if (!GuestReadable(base, frame)) break;
+    const uint32_t back = memory::load_and_swap<uint32_t>(base + frame);
+    if (back <= frame || back >= 0x80000000u || (back & 3)) break;
+    if (!GuestReadable(base, back - 8)) break;
+    out[i] = memory::load_and_swap<uint32_t>(base + back - 8);
+    frame = back;
+  }
+}
+
+std::vector<object_ref<XThread>> RunningGuestThreads(KernelState* ks) {
+  std::vector<object_ref<XThread>> result;
+  for (auto& t : ks->object_table()->GetObjectsByType<XThread>()) {
+    if (t && t->is_guest_thread() && t->is_running()) result.push_back(t);
+  }
+  std::sort(result.begin(), result.end(),
+            [](const object_ref<XThread>& a, const object_ref<XThread>& b) {
+              return a->handle() < b->handle();
+            });
+  return result;
+}
+
+// ============================================================================
+// Freeze: park every other guest-code-running thread, pause audio, drain GPU
+// ============================================================================
+class Freeze {
+ public:
+  Freeze(KernelState* ks, bool first_attempt) : ks_(ks), first_attempt_(first_attempt) {}
+  ~Freeze() { End(); }
+
+  // Returns false (and undoes everything) when the game isn't at a quiet moment.
+  bool Begin(std::string* why) {
+    auto* runtime = ks_->emulator();
+    audio_ = runtime ? dynamic_cast<audio::AudioSystem*>(runtime->audio_system()) : nullptr;
+    gpu_ = runtime ? runtime->graphics_system() : nullptr;
+
+    // Only the XMA decoder is paused (its worker writes guest memory on its own
+    // and never runs guest code). The audio worker is NOT paused: pausing it
+    // blocks until its guest callback returns, which can depend on this very
+    // thread. It is held at the gate like any other guest-code runner.
+    xma_ = audio_ ? audio_->xma_decoder() : nullptr;
+    if (xma_ && !xma_->is_paused()) {
+      xma_->Pause();
+      paused_xma_ = true;
+    }
+
+    // 1. Let the GPU drain what has been submitted (guest threads still run, so
+    //    interrupts and render threads can finish the frame in flight).
+    // 2. Close the gate and wait for every other thread to reach a kernel wait.
+    // 3. If the GPU is still idle, the world is quiet: freeze succeeded.
+    // Otherwise reopen the gate and try again until the deadline.
+    const auto deadline = Clock::now() + std::chrono::milliseconds(first_attempt_ ? 120 : 30);
+    for (;;) {
+      while (gpu_ && !gpu_->GeStateIsIdle()) {
+        if (Clock::now() > deadline) {
+          *why = "GPU busy";
+          End();
+          return false;
+        }
+        std::this_thread::sleep_for(std::chrono::microseconds(200));
+      }
+      {
+        std::lock_guard<std::mutex> lock(g_gate_mutex);
+        g_active.store(true, std::memory_order_seq_cst);
+      }
+      active_ = true;
+      const auto park_deadline =
+          std::min(deadline, Clock::now() + std::chrono::milliseconds(40));
+      bool parked = true;
+      while (g_running.load(std::memory_order_seq_cst) > 1) {
+        if (Clock::now() > park_deadline) {
+          parked = false;
+          break;
+        }
+        std::this_thread::sleep_for(std::chrono::microseconds(200));
+      }
+      if (parked && (!gpu_ || gpu_->GeStateIsIdle())) {
+        return true;
+      }
+      const int running = g_running.load() - 1;
+      const std::string names = parked ? std::string() : CountedThreadNames();
+      OpenGate();
+      if (Clock::now() > deadline) {
+        *why = parked ? std::string("GPU busy")
+                      : "threads busy (" + std::to_string(running) + ": " + names + ")";
+        End();
+        return false;
+      }
+    }
+  }
+
+  void End() {
+    OpenGate();
+    if (paused_xma_ && xma_) {
+      xma_->Resume();
+      paused_xma_ = false;
+    }
+  }
+
+  void OpenGate() {
+    if (!active_) return;
+    {
+      std::lock_guard<std::mutex> lock(g_gate_mutex);
+      g_active.store(false, std::memory_order_seq_cst);
+    }
+    g_gate_cv.notify_all();
+    active_ = false;
+  }
+
+  audio::AudioSystem* audio() const { return audio_; }
+  IGraphicsSystem* gpu() const { return gpu_; }
+
+ private:
+  KernelState* ks_;
+  audio::AudioSystem* audio_ = nullptr;
+  IGraphicsSystem* gpu_ = nullptr;
+  audio::XmaDecoder* xma_ = nullptr;
+  bool first_attempt_ = true;
+  bool paused_xma_ = false;
+  bool active_ = false;
+};
+
+enum : uint8_t { kObjEvent = 1, kObjSemaphore = 2, kObjFile = 3 };
+
+// At most one diagnostic line per second while a request keeps retrying.
+bool LogThrottle() {
+  static std::atomic<int64_t> last{0};
+  const int64_t now =
+      std::chrono::duration_cast<std::chrono::milliseconds>(Clock::now().time_since_epoch())
+          .count();
+  int64_t prev = last.load();
+  return now - prev >= 1000 && last.compare_exchange_strong(prev, now);
+}
