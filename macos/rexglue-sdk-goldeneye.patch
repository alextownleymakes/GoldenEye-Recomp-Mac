@@ -129,6 +129,32 @@ class CommandProcessor {
   bool Save(::rex::stream::ByteStream* stream);
   bool Restore(::rex::stream::ByteStream* stream);
 
+  // GoldenEye save states.
+  // Idle: the worker is in its wait-for-commands loop with the ring drained.
+  bool GeIsIdle() const {
+    return ge_idle_.load(std::memory_order_acquire) &&
+           read_ptr_index_ == write_ptr_index_.load(std::memory_order_acquire);
+  }
+  // Ring state: {primary_buffer_ptr, primary_buffer_size, read_ptr_update_freq,
+  // read_ptr_writeback_ptr, read/write index}.
+  void GeGetRing(uint32_t out[5]) const {
+    out[0] = primary_buffer_ptr_;
+    out[1] = primary_buffer_size_;
+    out[2] = read_ptr_update_freq_;
+    out[3] = read_ptr_writeback_ptr_;
+    out[4] = read_ptr_index_;
+  }
+  // Must run ON the worker thread (via CallInThread) so the idle loop never
+  // sees a half-updated read/write pair.
+  void GeSetRingOnWorker(const uint32_t in[5]) {
+    primary_buffer_ptr_ = in[0];
+    primary_buffer_size_ = in[1];
+    read_ptr_update_freq_ = in[2];
+    read_ptr_writeback_ptr_ = in[3];
+    write_ptr_index_.store(in[4], std::memory_order_release);
+    read_ptr_index_ = in[4];
+  }
+
  protected:
   struct IndexBufferInfo {
     xenos::IndexFormat format = xenos::IndexFormat::kInt16;
@@ -267,6 +293,7 @@ class CommandProcessor {
