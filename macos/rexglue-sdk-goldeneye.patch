+// GoldenEye save states -------------------------------------------------------
+namespace {
+constexpr uint32_t kGeGpuStateMagic = 0x47454750;  // 'GEGP'
+}
+
+bool GraphicsSystem::GeStateIsIdle() {
+  return command_processor_ && command_processor_->GeIsIdle();
+}
+
+bool GraphicsSystem::GeStateSave(std::vector<uint8_t>& out) {
+  if (!GeStateIsIdle()) {
+    return false;
+  }
+  uint32_t words[7] = {kGeGpuStateMagic};
+  command_processor_->GeGetRing(&words[1]);
+  words[6] = command_processor_->counter();
+  const auto* bytes = reinterpret_cast<const uint8_t*>(words);
+  out.insert(out.end(), bytes, bytes + sizeof(words));
+  return true;
+}
+
+bool GraphicsSystem::GeStateRestore(const uint8_t* data, size_t size) {
+  uint32_t words[7];
+  if (size < sizeof(words) || !command_processor_) {
+    return false;
+  }
+  std::memcpy(words, data, sizeof(words));
+  if (words[0] != kGeGpuStateMagic || !GeStateIsIdle()) {
+    return false;
+  }
+  // Put the ring back where the restored guest expects it and drop every GPU
+  // copy of guest memory (textures, render targets, vertex data): all of it is
+  // re-read from the restored RAM. Runs on the GPU worker, which is idle.
+  rex::thread::Fence fence;
+  command_processor_->CallInThread([this, &words, &fence]() {
+    command_processor_->GeSetRingOnWorker(&words[1]);
+    if (words[3]) {
+      memory::store_and_swap<uint32_t>(memory_->TranslatePhysical(words[3]), words[5]);
+    }
+    command_processor_->InvalidateGpuMemory();
+    command_processor_->ClearCaches();
+    fence.Signal();
+  });
+  fence.Wait();
+  return true;
+}
