index 2b02d47..d234904 100644
--- a/src/gbi/rt64_gbi_f3dgolden.cpp
+++ b/src/gbi/rt64_gbi_f3dgolden.cpp
@@ -7,6 +7,9 @@
 #include "hle/rt64_interpreter.h"
 
 #include "rt64_gbi_f3d.h"
+#include "rt64_gbi_rdp.h"
+
+#include <vector>
 
 namespace RT64 {
     namespace GBI_F3DGOLDEN {
@@ -27,11 +30,78 @@ namespace RT64 {
             }
         }
         
+        // GoldenEye's sky streams raw RDP triangles through the microcode 32
+        // bits at a time: G_RDPHALF_1 / G_RDPHALF_CONT pairs carry each 64-bit
+        // RDP word, starting with a triangle command, and G_RDPHALF_2 carries
+        // the last half. Gather them and draw the triangles.
+        static std::vector<uint32_t> rdpWords;
+        static bool rdpCollecting = false;
+
+        static bool isRdpTriangle(uint32_t word) {
+            const uint32_t command = (word >> 24) & 0x3F;
+            return (command >= 0x08) && (command <= 0x0F);
+        }
+
+        static void flushRdpWords(State *state) {
+            if (rdpWords.size() % 2) {
+                rdpWords.push_back(0);
+            }
+            std::vector<DisplayList> commands(rdpWords.size() / 2);
+            for (size_t i = 0; i < commands.size(); i++) {
+                commands[i].w0 = rdpWords[i * 2];
+                commands[i].w1 = rdpWords[i * 2 + 1];
+            }
+            DisplayList *cursor = commands.data();
+            DisplayList *end = commands.data() + commands.size();
+            while ((cursor < end) && isRdpTriangle(cursor->w0)) {
+                DisplayList *next = GBI_RDP::decodeTriangles(state, cursor, size_t(end - cursor));
+                if (next <= cursor) {
+                    break;
+                }
+                cursor = next;
+            }
+            rdpWords.clear();
+            rdpCollecting = false;
+        }
+
+        void rdpHalf1(State *state, DisplayList **dl) {
+            const uint32_t word = (*dl)->w1;
+            if (!rdpCollecting && isRdpTriangle(word)) {
+                rdpWords.clear();
+                rdpCollecting = true;
+            }
+            if (rdpCollecting) {
+                rdpWords.push_back(word);
+            }
+            else {
+                GBI_F3D::rdpHalf1(state, dl);
+            }
+        }
+
+        void rdpHalfCont(State *state, DisplayList **dl) {
+            if (rdpCollecting) {
+                rdpWords.push_back((*dl)->w1);
+            }
+        }
+
+        void rdpHalf2(State *state, DisplayList **dl) {
+            if (rdpCollecting) {
+                rdpWords.push_back((*dl)->w1);
+                flushRdpWords(state);
+            }
+            else {
+                GBI_F3D::rdpHalf2(state, dl);
+            }
+        }
+
         void setup(GBI *gbi) {
             GBI_F3D::setup(gbi);
 
             gbi->map[F3DGOLDEN_G_TRIX] = &triX;
             gbi->map[F3DGOLDEN_G_MOVEWORD] = GBI_F3D::moveWord;
+            gbi->map[F3D_G_RDPHALF_1] = &rdpHalf1;
+            gbi->map[F3D_G_RDPHALF_2] = &rdpHalf2;
+            gbi->map[0xB2] = &rdpHalfCont;  // G_RDPHALF_CONT
         }
     }
 };
